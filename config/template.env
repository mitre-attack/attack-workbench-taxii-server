# Template-Version: 1.0
# Template-Updated: 2026-10-11
# Template-Source: attack-workbench-taxii-server/config/template.env
#
# Changelog
# ---------
# - 1.0 (2026-10-11): Document server settings and PEM helper inputs

# **********************************************************
# ***** ENVIRONMENT ****************************************
# **********************************************************
# Select config/<value>.env via the shell or container environment before startup.
TAXII_ENV=dev

# **********************************************************
# ***** SERVER SETTINGS ************************************
# **********************************************************
# Interface to bind (default: 0.0.0.0).
TAXII_APP_ADDRESS=0.0.0.0
# HTTP port (default: 8000).
TAXII_APP_PORT=8000
# HTTPS port when enabled (default: 8443).
TAXII_APP_PORT_HTTPS=8443
# Enable the HTTPS listener (default: false).
TAXII_HTTPS_ENABLED=false
# Base64-encoded PEM private key; required for HTTPS.
TAXII_SSL_PRIVATE_KEY=
# Base64-encoded PEM certificate; required for HTTPS.
TAXII_SSL_PUBLIC_KEY=
# Allow browser cross-origin requests (default: false).
TAXII_CORS_ENABLED=false
# JSON request-body size limit passed to Express (runtime default: 1000).
TAXII_MAX_CONTENT_LENGTH=0

# **********************************************************
# ***** NGINX SSL/TLS CERTIFICATE AUTO REG/RENEW ***********
# **********************************************************
CERTBOT_LE_FQDN=taxii.example.com
CERTBOT_LE_EMAIL=contact@example.com
CERTBOT_LE_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
CERTBOT_LE_RSA_KEY_SIZE=4096

# **********************************************************
# ***** CONTACT INFORMATION ********************************
# **********************************************************
# API route prefix, also advertised by discovery (runtime default: /api/v21).
TAXII_API_ROOT_PATH=/api
# Title advertised in discovery and API-root information.
TAXII_API_ROOT_TITLE=ATT&CK Workbench TAXII 2.1 Server
# Description advertised in discovery and API-root information.
TAXII_API_ROOT_DESCRIPTION=Provides access to the latest version of ATT&CK data through a TAXII 2.1 compliant REST API
# Contact email loaded by configuration (default: no-reply@your-company.tld).
TAXII_CONTACT_EMAIL=contact@example.com

# **********************************************************
# ***** CACHE SETTINGS *************************************
# **********************************************************
# Legacy entries: current server source does not read TAXII_CACHE_* variables.
TAXII_CACHE_TYPE=memcached
TAXII_CACHE_HOST=attack-workbench-taxii-cache
TAXII_CACHE_PORT=11211
TAXII_CACHE_TTL=600
TAXII_CACHE_MAX_ITEM_SIZE=50m
TAXII_CACHE_MEM_SIZE=4096
TAXII_CACHE_RECONNECT=true

# **********************************************************
# ***** STIX/WORKBENCH SETTINGS ****************************
# **********************************************************
# Determines where STIX data is sourced from. Supported values:
#   workbench    - hydrate from a running ATT&CK Workbench REST API instance (default)
#   mitre-attack - hydrate from the official MITRE ATT&CK releases on GitHub (mitre-attack/attack-stix-data)
TAXII_STIX_DATA_SRC=workbench
# Workbench API origin, without /api; used by the workbench data provider.
TAXII_STIX_SRC_URL=http://rest-api:3000
# Base64 user:API-key value for Workbench Basic service authentication.
TAXII_WORKBENCH_AUTH_HEADER=dGF4aWktc2VydmVyOnNlY3JldC1zcXVpcnJlbA==
# Only used when TAXII_STIX_DATA_SRC=mitre-attack. Defaults to the raw GitHub content URL for
# mitre-attack/attack-stix-data. Override to point at a mirror of the repository.
#TAXII_MITRE_ATTACK_DATA_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master

# **********************************************************
# ***** DATABASE SETTINGS **********************************
# **********************************************************
# MongoDB connection URI for the TAXII data store.
TAXII_MONGO_URI=mongodb://mongodb:27017/taxii
# Hydrate the selected data source at collector startup (runtime default: false).
TAXII_HYDRATE_ON_BOOT=true

# **********************************************************
# ***** LOGGING SETTINGS ***********************************
# **********************************************************
# Logging verbosity; example: verbose. The template overrides the runtime default.
TAXII_LOG_LEVEL=verbose
# Enable dated taxii_server_*.log output with true (default: false).
TAXII_LOG_TO_FILE=
# Optional HTTP log receiver host; unset disables this transport.
TAXII_LOG_TO_HTTP_HOST=
# HTTP log receiver port (1-65535).
TAXII_LOG_TO_HTTP_PORT=
# HTTP log receiver path, such as /logs.
TAXII_LOG_TO_HTTP_PATH=
# Optional Slack webhook URL; unset disables this transport.
TAXII_LOG_TO_SLACK_URL=
# Optional Sentry DSN; unset disables this transport.
TAXII_LOG_TO_SENTRY_DSN=

# **********************************************************
# ***** PEM ENCODING HELPER *********************************
# **********************************************************
# Only scripts/encodePem.js reads these paths; the server does not.
# Export them before running the helper, or use Node's --env-file option.
# The helper prints encoded values for TAXII_SSL_PRIVATE_KEY/PUBLIC_KEY.
#TAXII_PATH_TO_PRIVATE_KEY=/path/to/private-key.pem
#TAXII_PATH_TO_PUBLIC_KEY=/path/to/public-certificate.pem
